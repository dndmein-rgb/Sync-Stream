generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Minimal Phase 0 model — just enough to prove the DB connection.
// Full User / Room / RoomMember models arrive in Phase 1–2.
model HealthCheck {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
}